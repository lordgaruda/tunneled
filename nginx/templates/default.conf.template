# ==============================================================================
# WebSocket Connection Upgrade Mapping
# ==============================================================================
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ==============================================================================
# Dynamic Reverse Proxy Server Block (Generated by envsubst)
# ==============================================================================
server {
    listen 80;
    server_name ${PRIMARY_DOMAIN} localhost _;

    # Client limits from ENV
    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    # Include security headers
    include /etc/nginx/conf.d/security_headers.conf;

    # Static fallback root
    root /usr/share/nginx/html;
    index index.html;

    # --------------------------------------------------------------------------
    # Health check probe
    # --------------------------------------------------------------------------
    location /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "OK\n";
    }

    # --------------------------------------------------------------------------
    # Diagnostic whoami endpoint
    # --------------------------------------------------------------------------
    location /whoami/ {
        proxy_pass http://whoami:80/;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # --------------------------------------------------------------------------
    # Main Application Proxy / Static Routing
    # --------------------------------------------------------------------------
    location / {
        # Check static files first, then proxy to configured upstream service
        try_files $uri $uri/ @upstream_proxy;
    }

    location @upstream_proxy {
        proxy_pass http://${UPSTREAM_APP_HOST}:${UPSTREAM_APP_PORT};
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Custom Error Pages
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}

