# ==============================================================================
# 100% ENV-BASED CLOUDFLARE TUNNEL CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION A: TOKEN MODE (Recommended - Cloudflare Zero Trust Remote Managed)
# ------------------------------------------------------------------------------
# Paste the Tunnel Token from your Cloudflare Zero Trust Dashboard:
# (Access -> Tunnels -> Create Tunnel -> Docker command -> copy token string)
TUNNEL_TOKEN_PRIMARY=your_primary_cloudflare_tunnel_token_here

# Optional: Secondary Cloudflare Tunnel Token (Multi-tunnel support)
# To enable the secondary tunnel, uncomment the line below or run with profile
# COMPOSE_PROFILES=multi-tunnel
TUNNEL_TOKEN_SECONDARY=


# ------------------------------------------------------------------------------
# OPTION B: AUTO-GENERATED CONFIG MODE (If using local Tunnel UUID / credentials)
# ------------------------------------------------------------------------------
# If you don't use TUNNEL_TOKEN, you can provide TUNNEL_ID and it will auto-generate config.yml:
# TUNNEL_ID=your-tunnel-uuid-here
# TUNNEL_CREDENTIALS_BASE64=
# TUNNEL_PROTOCOL=auto
# FORCE_GENERATE_CONFIG=false


# ------------------------------------------------------------------------------
# NGINX REVERSE PROXY & APPLICATION ROUTING SETTINGS
# ------------------------------------------------------------------------------
# Primary domain or subdomain routed through Nginx
PRIMARY_DOMAIN=app.yourdomain.com

# Upstream application container and port to proxy traffic to
# (Defaults to the built-in 'whoami' diagnostic container for initial testing)
UPSTREAM_APP_HOST=whoami
UPSTREAM_APP_PORT=80

# Maximum upload payload size allowed by Nginx
CLIENT_MAX_BODY_SIZE=50M

# Timezone
TZ=UTC
